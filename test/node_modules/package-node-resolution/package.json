{
  "name": "package-node-resolution",
  "type": "module",
  "exports": {
    ".": {
      "default": {"require": "./index.js"},
      "import": "./index.js"
    },
    "./array": {
      "default": [{"require": "./index.js"}],
      "import": "./index.js"
    },
    "./blocked": {
      "default": {"node": null},
      "import": "./index.js"
    }
  },
  "imports": {
    "#feature/*.js": "./*.js"
  }
}
